# Website (this folder). Copy to .env. Never put database, R2 or email keys here: those live in backend/.env.

# Port the website runs on (npm run dev / npm start). Default 3010.
PORT=3010

# Where the backend is, as THIS server reaches it (server-to-server; browsers never see it).
# Local: the backend's PORT on this machine. Production: its private address, same region.
OTS_API_URL=http://127.0.0.1:5021

# Shared secret with the backend: the SAME value as OTS_INTERNAL_KEY in backend/.env. The backend
# only accepts the request form from a caller holding it. Server-side only; never NEXT_PUBLIC_.
OTS_INTERNAL_KEY=
