# Backend: API (/v1/*) + admin portal (/admin). Copy to backend/.env.
# This is the ONLY place credentials live. Never add SUPABASE_SERVICE_ROLE, or any R2 key other than
# the preview one below.

# --- Server -------------------------------------------------------------------------------------
# Port the backend runs on (npm run dev / npm start). Default 5021. The website's OTS_API_URL points here.
PORT=5021
# Admin session cookie is HTTPS-only by default. Set false only for local http (localhost) testing.
COOKIE_SECURE=false
# Browser origins allowed to call the API directly (comma-separated). Leave empty: the website calls
# it from its own server, which needs no CORS.
# CORS_ORIGINS=
# Behind a load balancer that sets X-Forwarded-For (for the per-visitor submit limit). Default true.
# TRUST_PROXY=true
# Request form: submissions per visitor IP per window. Defaults 10 per 600 s.
# SUBMIT_LIMIT=10
# SUBMIT_WINDOW_S=600
# How long the inventory is kept before asking Supabase again. Default 300 s.
# INVENTORY_TTL_S=300

# --- Supabase (requests, inventory, admin login) -------------------------------------------------
SUPABASE_ANON_PUBLIC=
# Optional. By default this comes from the anon key.
# SUPABASE_URL=https://<project>.supabase.co

# --- Email (Resend) ------------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Awign Robotics Data <data@awign.in>
SAMPLE_DRIVE_URL_EGO=
OFFER_MCAP=true

# --- Preview videos (R2) -------------------------------------------------------------------------
# Its own R2 API token: Object Read only, scoped to the preview bucket. The backend streams the
# video; browsers never see the endpoint, bucket, key or file paths.
# Layout: <slug>/<slug>.mp4 is clip 1, then <slug>/<slug>-2.mp4 ...; head + wrist under head-wrist/<slug>/.
PREVIEW_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
PREVIEW_R2_BUCKET=
PREVIEW_R2_ACCESS_KEY_ID=
PREVIEW_R2_SECRET_ACCESS_KEY=
# Optional. Clips are kept on this server's disk after the first view.
# Defaults: <os tmp>/ots-preview-cache, 3072 MB. 0 turns the cache off.
# PREVIEW_CACHE_DIR=
# PREVIEW_CACHE_MAX_MB=3072
